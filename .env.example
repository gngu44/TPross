# Local development only. Copy to .env, then export it before starting Spring Boot.
DB_URL=jdbc:postgresql://localhost:5432/tpross
DB_USERNAME=tpross
DB_PASSWORD=tpross

# Used by Docker Compose. Keep these consistent with DB_URL.
DB_NAME=tpross
DB_PORT=5432

# Applied only when the Spring local profile is active.
DEV_STARTING_BALANCE=1000.00
